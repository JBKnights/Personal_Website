---
export type IconName = "scholar" | "github" | "linkedin" | "email";

export interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

{
  name === "scholar" && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2 1 8.5l4 2.32V17l7 4 7-4v-6.18l2-1.16V17h1V8.5L12 2Zm0 2.29 7.53 4.37L12 12.98 4.47 8.66 12 4.29ZM6 12.06l5.5 3.19a1 1 0 0 0 1 0l5.5-3.19v3.71l-6 3.43-6-3.43v-3.71Z" />
    </svg>
  )
}
{
  name === "github" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
    </svg>
  )
}
{
  name === "linkedin" && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M4.98 3.5a2.5 2.5 0 1 0 .02 5 2.5 2.5 0 0 0-.02-5ZM3.2 8.98h3.56V21H3.2V8.98Zm6.28 0h3.41v1.64h.05c.48-.9 1.64-1.85 3.38-1.85 3.62 0 4.28 2.38 4.28 5.48V21h-3.56v-5.98c0-1.43-.03-3.26-1.99-3.26-2 0-2.3 1.56-2.3 3.16V21H9.48V8.98Z" />
    </svg>
  )
}
{
  name === "email" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  )
}
